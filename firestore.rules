rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net - Deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for UserProfile
    function isValidUserProfile(data, userId) {
      return data.userId is string && data.userId == userId
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100
        && data.email is string && data.email.size() > 0 && data.email.size() <= 150
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000))
        && (!('level' in data) || (data.level is number && data.level >= 1))
        && (!('currentStreak' in data) || (data.currentStreak is number && data.currentStreak >= 0))
        && (!('latestMood' in data) || (data.latestMood == null || data.latestMood == 'happy' || data.latestMood == 'neutral' || data.latestMood == 'sad' || data.latestMood == 'angry' || data.latestMood == 'tired' || data.latestMood == 'relax' || data.latestMood == 'sleepy' || data.latestMood == 'romantic' || data.latestMood == 'sick'))
        && (!('latestMoodDate' in data) || (data.latestMoodDate == null || (data.latestMoodDate is string && data.latestMoodDate.size() <= 10)))
        && (!('latestMoodReason' in data) || (data.latestMoodReason == null || (data.latestMoodReason is string && data.latestMoodReason.size() <= 1000)))
        && (!('latestMoodIsPrivate' in data) || data.latestMoodIsPrivate is bool)
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    // Validation for FriendRequest
    function isValidFriendRequest(data) {
      return isValidId(data.id)
        && data.senderId is string && data.senderId == request.auth.uid
        && data.receiverId is string && data.receiverId.size() > 0 && data.receiverId.size() <= 128
        && data.senderName is string && data.senderName.size() > 0 && data.senderName.size() <= 100
        && data.receiverName is string && data.receiverName.size() > 0 && data.receiverName.size() <= 100
        && (data.status == 'pending' || data.status == 'accepted' || data.status == 'declined');
    }

    // Validation for NudgeNotification
    function isValidNudge(data) {
      return isValidId(data.id)
        && data.senderId is string && data.senderId == request.auth.uid
        && data.receiverId is string && data.receiverId.size() > 0 && data.receiverId.size() <= 128
        && data.senderName is string && data.senderName.size() > 0 && data.senderName.size() <= 100
        && data.receiverName is string && data.receiverName.size() > 0 && data.receiverName.size() <= 100
        && (!('senderPhoto' in data) || (data.senderPhoto is string && data.senderPhoto.size() <= 1000))
        && data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.read is bool
        && data.createdAt is string && data.createdAt.size() <= 50;
    }

    // Validation for StatusReaction
    function isValidStatusReaction(data) {
      return isValidId(data.id)
        && data.senderId is string && data.senderId == request.auth.uid
        && data.targetUserId is string && data.targetUserId.size() > 0 && data.targetUserId.size() <= 128
        && data.senderName is string && data.senderName.size() > 0 && data.senderName.size() <= 100
        && (!('senderPhoto' in data) || data.senderPhoto == null || (data.senderPhoto is string && data.senderPhoto.size() <= 1000))
        && data.targetMood is string && (data.targetMood == 'happy' || data.targetMood == 'neutral' || data.targetMood == 'sad' || data.targetMood == 'angry' || data.targetMood == 'tired' || data.targetMood == 'relax' || data.targetMood == 'sleepy' || data.targetMood == 'romantic' || data.targetMood == 'sick')
        && data.emoji is string && data.emoji.size() <= 10
        && data.label is string && data.label.size() <= 50
        && data.read is bool
        && data.createdAt is string && data.createdAt.size() <= 50
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    // Validation for CroodCheckInNotification
    function isValidCroodCheckInNotification(data) {
      return isValidId(data.id)
        && data.senderId is string && data.senderId == request.auth.uid
        && data.receiverId is string && data.receiverId.size() > 0 && data.receiverId.size() <= 128
        && data.senderName is string && data.senderName.size() > 0 && data.senderName.size() <= 100
        && (!('senderPhoto' in data) || data.senderPhoto == null || (data.senderPhoto is string && data.senderPhoto.size() <= 1000))
        && data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.message is string && data.message.size() > 0 && data.message.size() <= 100
        && data.read is bool
        && data.createdAt is string && data.createdAt.size() <= 50
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    // Validation for MoodEntry
    function isValidMoodEntry(data, userId) {
      return data.id is string && isValidId(data.id)
        && data.userId is string && data.userId == userId
        && data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.mood is string && (data.mood == 'happy' || data.mood == 'neutral' || data.mood == 'sad' || data.mood == 'angry' || data.mood == 'tired' || data.mood == 'relax' || data.mood == 'sleepy' || data.mood == 'romantic' || data.mood == 'sick')
        && (!('reason' in data) || (data.reason is string && data.reason.size() <= 1000))
        && (!('isPrivateReason' in data) || data.isPrivateReason is bool)
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 10))
        && (!('timestamp' in data) || data.timestamp is number)
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50))
        && data.xpEarned is number && data.xpEarned >= 0 && data.xpEarned <= 200;
    }

    // Validation for UserStats
    function isValidUserStats(data, userId) {
      return data.userId is string && data.userId == userId
        && data.currentStreak is number && data.currentStreak >= 0
        && data.longestStreak is number && data.longestStreak >= 0
        && data.totalCheckIns is number && data.totalCheckIns >= 0
        && data.currentXp is number && data.currentXp >= 0
        && data.level is number && data.level >= 1
        && (!('lastCheckInDate' in data) || (data.lastCheckInDate is string && data.lastCheckInDate.size() <= 10));
    }

    // Public searchable User Profiles for finding friends & showing Feeds
    match /users/{userId} {
      allow get, list: if isSignedIn();

      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId);

      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && (!('userId' in existing()) || incoming().userId == existing().userId);
    }

    // User-scoped Mood Entries subcollection
    match /users/{userId}/entries/{entryId} {
      allow get, list, delete: if isOwner(userId) && isValidId(userId);

      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidId(entryId)
        && isValidMoodEntry(incoming(), userId)
        && incoming().id == entryId;

      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidId(entryId)
        && isValidMoodEntry(incoming(), userId)
        && incoming().id == entryId
        && (!('id' in existing()) || incoming().id == existing().id)
        && (!('userId' in existing()) || incoming().userId == existing().userId)
        && (!('date' in existing()) || incoming().date == existing().date);
    }

    // User-scoped Gamification Stats
    match /users/{userId}/stats/{statId} {
      allow get, list: if isOwner(userId) && isValidId(userId);

      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidId(statId)
        && isValidUserStats(incoming(), userId);

      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidId(statId)
        && isValidUserStats(incoming(), userId)
        && incoming().userId == existing().userId;
    }

    // Friend Requests & Accepted Crood friendships
    match /friend_requests/{requestId} {
      allow get, list: if isSignedIn()
        && (resource == null || resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);

      allow create: if isSignedIn()
        && isValidFriendRequest(incoming())
        && incoming().senderId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().id == requestId;

      allow update: if isSignedIn()
        && (resource.data.receiverId == request.auth.uid || resource.data.senderId == request.auth.uid);

      allow delete: if isSignedIn()
        && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
    }

    // Real-time Crood check-in nudges
    match /nudges/{nudgeId} {
      allow get, list: if isSignedIn()
        && (resource == null || resource.data.receiverId == request.auth.uid || resource.data.senderId == request.auth.uid);

      allow create: if isSignedIn()
        && isValidId(nudgeId)
        && isValidNudge(incoming())
        && incoming().senderId == request.auth.uid
        && incoming().id == nudgeId;

      allow update: if isSignedIn()
        && (resource.data.receiverId == request.auth.uid || resource.data.senderId == request.auth.uid)
        && incoming().senderId == existing().senderId
        && incoming().receiverId == existing().receiverId
        && incoming().date == existing().date
        && incoming().read is bool
        && incoming().diff(existing()).affectedKeys().hasOnly(['read', 'updatedAt']);

      allow delete: if isSignedIn()
        && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
    }

    // Real-time peer reactions to current mood status
    match /status_reactions/{reactionId} {
      allow get, list: if isSignedIn()
        && (resource == null || resource.data.targetUserId == request.auth.uid || resource.data.senderId == request.auth.uid);

      allow create: if isSignedIn()
        && isValidId(reactionId)
        && isValidStatusReaction(incoming())
        && incoming().senderId == request.auth.uid
        && incoming().id == reactionId;

      allow update: if isSignedIn()
        && (resource.data.targetUserId == request.auth.uid || resource.data.senderId == request.auth.uid)
        && incoming().senderId == existing().senderId
        && incoming().targetUserId == existing().targetUserId
        && incoming().diff(existing()).affectedKeys().hasOnly(['emoji', 'label', 'targetMood', 'read', 'updatedAt']);

      allow delete: if isSignedIn()
        && (resource.data.targetUserId == request.auth.uid || resource.data.senderId == request.auth.uid);
    }

    // Real-time Crood check-in push notifications (sent once per day)
    match /crood_checkin_notifications/{notificationId} {
      allow get, list: if isSignedIn()
        && (resource == null || resource.data.receiverId == request.auth.uid || resource.data.senderId == request.auth.uid);

      allow create: if isSignedIn()
        && isValidId(notificationId)
        && isValidCroodCheckInNotification(incoming())
        && incoming().senderId == request.auth.uid
        && incoming().id == notificationId;

      allow update: if isSignedIn()
        && (resource.data.receiverId == request.auth.uid || resource.data.senderId == request.auth.uid)
        && incoming().senderId == existing().senderId
        && incoming().receiverId == existing().receiverId
        && incoming().date == existing().date
        && incoming().read is bool
        && incoming().diff(existing()).affectedKeys().hasOnly(['read', 'updatedAt']);

      allow delete: if isSignedIn()
        && (resource.data.receiverId == request.auth.uid || resource.data.senderId == request.auth.uid);
    }
  }
}
